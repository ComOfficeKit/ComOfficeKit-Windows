<Window x:Class="SampleWpfPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sample-WpfPreview" Width="900" Height="1000">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
      <Button x:Name="OpenButton" Content="Open..." Padding="12,4" Click="Open_Click" />
      <Button x:Name="PreviousButton" Content="&lt;" Padding="12,4" Margin="16,0,0,0" Click="Previous_Click" IsEnabled="False" />
      <TextBlock x:Name="PageLabel" Margin="8,0" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
      <Button x:Name="NextButton" Content="&gt;" Padding="12,4" Click="Next_Click" IsEnabled="False" />
      <TextBlock x:Name="StatusLabel" Margin="16,0" VerticalAlignment="Center" Foreground="Gray" />
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E6E6E6">
      <Image x:Name="PageView" Stretch="None" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </ScrollViewer>
  </DockPanel>
</Window>
