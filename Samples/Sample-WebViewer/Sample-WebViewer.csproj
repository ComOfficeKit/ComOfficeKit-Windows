<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The web viewer sample (docs/servers.md, "Showing documents in a browser"): a service that answers a document's
    pages as PNG and the document as PDF, and a page that shows them. ComOfficeKit comes from packages/, through
    Samples/nuget.config and Samples/Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ComOfficeKit" Version="$(ComOfficeKitVersion)" />
  </ItemGroup>
</Project>
